APP_NAME=LET THEM SPEAK BEFORE THEY BREAK
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/let_them_speak.db
CORS_ORIGINS=http://localhost:5173

# AI provider: ollama | openai_compatible | fallback
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional OpenAI-compatible provider
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Safety defaults for India; change/extend for your deployment region.
EMERGENCY_NUMBER=112
MENTAL_HEALTH_HELPLINE=14416
